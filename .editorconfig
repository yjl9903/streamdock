root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,toml,json}]
indent_size = 2

# Preserve upstream file hashes and unified-diff context lines.
[src/streamdock/_vendor/mirabox/**]
charset = unset
end_of_line = unset
insert_final_newline = false
trim_trailing_whitespace = false

[scripts/sdk/patches/*.patch]
trim_trailing_whitespace = false
